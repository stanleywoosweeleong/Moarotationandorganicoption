# ----- Build tooling & dependencies (never commit) -----
node_modules/
package.json
package-lock.json
yarn.lock

# ----- Generated build config (re-created by rebuild.sh each run) -----
tailwind.config.js
input.css
tailwind.css

# ----- Temp / intermediate build artifacts -----
*.tmp
*.tmp.js
*.log

# ----- OS / editor cruft -----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

